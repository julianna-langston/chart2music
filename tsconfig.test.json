{
    "compilerOptions": {
        "esModuleInterop": true,
        "removeComments": true,
        "target": "ES2020",
        "strict": false,
        "module": "CommonJS",
        "rootDir": ".",
        "preserveConstEnums": true,
        "isolatedModules": true,
        "moduleResolution": "Bundler",
        "typeRoots": ["node_modules/@types"],
        "types": ["jest", "node"]
    },
    "include": ["test/**/*"]
}
