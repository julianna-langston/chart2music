{
    "name": "chart2music",
    "version": "1.20.0",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "exports": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
    },
    "type": "commonjs",
    "types": "dist/index.d.ts",
    "description": "Turns charts into music so the blind can hear data",
    "files": [
        "dist/*"
    ],
    "keywords": [
        "a11y",
        "accessibility",
        "audio",
        "audio graph",
        "chart",
        "dataviz",
        "data visualization",
        "graph",
        "screen reader",
        "sonification"
    ],
    "homepage": "https://www.chart2music.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/julianna-langston/chart2music.git"
    },
    "bugs": {
        "url": "https://github.com/julianna-langston/chart2music/issues"
    },
    "scripts": {
        "build": "rollup -c rollup.config.mjs --silent && npm run build-cjs",
        "build-cjs": "npx babel ./dist/index.mjs --out-file ./dist/index.cjs",
        "clean": "rimraf ./dist ./coverage",
        "depcheck": "depcheck",
        "start": "concurrently \"rollup -c rollup.config.mjs -w\" \"http-server .\"",
        "lint-staged": "lint-staged",
        "lint-check": "eslint --quiet src/ && prettier --config .prettierrc.json src/**/*.ts --check",
        "format": "eslint src/ --fix && prettier --config .prettierrc.json src/**/*.ts --write && prettier examples/**/*.js --write",
        "prepare": "husky install",
        "test": "jest"
    },
    "license": "MIT",
    "devDependencies": {
        "@babel/cli": "7.29.7",
        "@babel/core": "7.29.7",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@babel/preset-env": "7.29.7",
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/jest": "30.0.0",
        "@typescript-eslint/eslint-plugin": "8.67.0",
        "@typescript-eslint/parser": "8.68.0",
        "concurrently": "10.0.5",
        "depcheck": "1.4.7",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsdoc": "64.2.1",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "lint-staged": "17.3.0",
        "prettier": "3.9.6",
        "rimraf": "6.1.3",
        "rollup": "4.63.0",
        "rollup-plugin-delete": "3.0.2",
        "rollup-plugin-dts": "6.5.1",
        "ts-jest": "29.4.12",
        "tslib": "2.8.1",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@formatjs/intl": "4.1.19",
        "screen-reader-bridge": "^2.0.0"
    }
}
