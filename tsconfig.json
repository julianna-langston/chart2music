{
    "compilerOptions": {
        "esModuleInterop": true,
        "declaration": true,
        "declarationDir": "./dist",
        "outDir": "./dist/",
        "removeComments": true,
        "target": "ES2020",
        "strict": false,
        "module": "ESNext",
        "rootDir": "./src",
        "preserveConstEnums": true,
        "moduleResolution": "Bundler",
        "types": ["node"],
        "isolatedModules": true
    },
    "include": ["src/**/*"],
    "exclude": ["test/**/*"]
}
